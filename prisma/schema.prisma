generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId    Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  slug      String   @unique
  timezone  String   @default("UTC") // central time zone
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventTypes             EventType[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  slots                  Slot[]
  bookings               Booking[]               @relation("HostBookings")

  @@map("users")
}

model EventType {
  eventTypeId         Int       @id @default(autoincrement())
  userId              Int
  title               String
  description         String?
  slug                String
  durationMinutes     Int
  isActive            Boolean   @default(true)
  locationType        String    @default("Online")
  locationValue       String?
  bufferBeforeMinutes Int       @default(0)
  bufferAfterMinutes  Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  host                User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  slots               Slot[]
  bookings            Booking[]

  @@unique([userId, slug]) // combination of hostId and slug to be unique.
  @@map("event_types")
}

model AvailabilityRule {
  ruleId    Int      @id @default(autoincrement())
  userId    Int
  weekday   Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, weekday])
  @@map("availability_rules")
}

model AvailabilityException {
  exceptionId Int      @id @default(autoincrement())
  userId      Int
  date        DateTime @db.Date
  type        String
  startTime   String?
  endTime     String?
  reason      String?
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, date])
  @@map("availability_exceptions")
}

model Slot {
  slotId      Int      @id @default(autoincrement())
  userId      Int
  eventTypeId Int
  startAt     DateTime
  endAt       DateTime
  status      String   @default("AVAILABLE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host      User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [eventTypeId], onDelete: Cascade)

  bookings Booking[]

  @@unique([eventTypeId, startAt, endAt])
  @@index([userId, startAt])
  @@index([eventTypeId, startAt, status])
  @@map("slots")
}

model Booking {
  bookingId    Int     @id @default(autoincrement())
  userId       Int
  eventTypeId  Int
  slotId       Int
  inviteeEmail String
  inviteeNotes String?
  inviteeName  String

  status          String    @default("PENDING")
  meetLink        String?
  calenderEventId String?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  host      User      @relation("HostBookings", fields: [userId], references: [userId], onDelete: Cascade)
  eventType EventType @relation(fields: [eventTypeId], references: [eventTypeId], onDelete: Cascade)
  slot      Slot      @relation(fields: [slotId], references: [slotId], onDelete: Cascade)

  @@index([inviteeEmail])
  @@index([userId, createdAt])
  @@index([status])
  @@map("bookings")
}
